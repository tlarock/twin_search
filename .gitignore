# Build tree, including the conan-generated configuration.
build/

# Generated results. Reproduce them with the scripts in scripts/; each run
# writes a RUN_MANIFEST.tsv recording the commit, seed and exact commands.
# Data belongs in a deposit, not in git.
results/

# Source archives and consolidated datasets
*.tar.gz
*.tar.zst

# Python / Jupyter
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/

# macOS
.DS_Store

# conan writes this per-user; it points at build/CMakePresets.json
CMakeUserPresets.json

# Cluster run-harness scripts. Machine-specific job plumbing for one SLURM
# site, not part of the reproduction pipeline - that lives in scripts/.
slurm-scripts/

# Laptop-side rsync harness for the same SLURM site. Same reasoning as
# slurm-scripts/: it carries cluster paths and is useful on one machine.
sync-della.sh

# One-off deposit upload harness. Operational, not part of the reproduction
# pipeline, and it reads a personal access token from outside the repo.
zenodo-upload.sh

# Generated figures. Every one is written by a notebook in analysis/notebooks/
# from the data in the deposit, so they are reproducible output, not source -
# same reasoning as results/.
analysis/plots/

# One-off deposit progress checker, same reasoning as zenodo-upload.sh.
zenodo-progress.sh
